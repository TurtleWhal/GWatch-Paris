#include "watch.hpp"
#include "ble.hpp"
#include <esp_adc/adc_oneshot.h>
#include <esp_adc/adc_cali.h>
#include <esp_adc/adc_cali_scheme.h>
#include "esp_system.h"
#include "esp_log.h"
#include <stdarg.h>
#include <stdio.h>

static const char *TAG = "battery";

// Send a `{"t":"info","msg":"<formatted>"}` GB message so a connected
// Gadgetbridge instance can show learning events (anchor updates) in
// its debug log. Useful when the watch isn't tethered to serial — the
// phone keeps a rolling log of received GB messages. No-op if no peer
// is subscribed.
static void send_info(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
static void send_info(const char *fmt, ...)
{
    char body[80];
    va_list ap;
    va_start(ap, fmt);
    vsnprintf(body, sizeof(body), fmt, ap);
    va_end(ap);

    char buf[128];
    snprintf(buf, sizeof(buf), "{\"t\":\"info\",\"msg\":\"%s\"}", body);
    ble.send_gb(buf);
}

static adc_oneshot_unit_handle_t adc1_handle;
static adc_cali_handle_t adc_cali_handle;

#define BAT_ADC_CHANNEL ADC_CHANNEL_0 // GPIO1
#define BAT_DIVIDER_RATIO 3.0f        // (R13 + R14) / R14 = 3.0

// Discharging-side bounds. The divider has a Schottky-style drop between
// cell and tap, so "full" rests around 3.9 V and the chip browns out
// around 2.6 V. The wide V_EMPTY bounds let the watch learn down toward
// the actual brown-out as the battery gets used.
#define V_FULL_MIN_MV 3700
#define V_FULL_MAX_MV 4000
#define V_FULL_DEFAULT_MV 3900

#define V_EMPTY_MIN_MV 2600
#define V_EMPTY_MAX_MV 3500
#define V_EMPTY_DEFAULT_MV 2800

static uint16_t v_full_mv = V_FULL_DEFAULT_MV;
static uint16_t v_empty_mv = V_EMPTY_DEFAULT_MV;

// Charging-side bounds — the divider reads the system rail (Vbus minus
// the Schottky drop) while plugged in, not the cell, so this is a
// separate scale. v_chg_full is the lifetime peak rail voltage (CV
// regulation, typically ~4.5–4.7 V on this board). v_chg_empty is the
// rail voltage when the cell is at brown-out and the charger is
// supplying current — learned once on a boot-from-brownout + USB
// scenario, since that's the only moment we know the cell really is
// empty while we're plugged in.
#define V_CHG_FULL_MIN_MV 4000
#define V_CHG_FULL_MAX_MV 4900
#define V_CHG_FULL_DEFAULT_MV 4500

#define V_CHG_EMPTY_MIN_MV 2800
#define V_CHG_EMPTY_MAX_MV 3900
#define V_CHG_EMPTY_DEFAULT_MV 3700

static uint16_t v_chg_full_mv = V_CHG_FULL_DEFAULT_MV;
static uint16_t v_chg_empty_mv = V_CHG_EMPTY_DEFAULT_MV;

// Voltage sag from "asleep resting" → "awake under typical load." Refined
// from awake↔asleep transitions and persisted to NVS so the first boot
// after fresh flash doesn't show 70% the moment you unplug from full.
// Stored with a +1000 mV bias to round-trip a signed value through the
// uint16 NVS API.
#define LOAD_OFFSET_DEFAULT_MV 200
#define LOAD_OFFSET_MAX_MV 400
#define LOAD_OFFSET_NVS_BIAS 1000
static int load_offset_mv = LOAD_OFFSET_DEFAULT_MV;

// Set in battery_init from esp_reset_reason() so the task can opportun-
// istically learn v_chg_empty on the very first plug-in spike + settle
// after a brown-out. Cleared once consumed (or once it becomes clear
// the cell wasn't actually empty when we lost power).
static bool boot_from_brownout = false;

// Typical LiPo discharge curve, normalised to [v_empty .. v_full]. The
// curve is well-known and roughly the same shape across cells; we just
// rescale it to whatever the per-device empty/full anchors happen to be.
// Each entry is (fractional voltage in [0..1], percent state-of-charge).
struct CurvePoint { float v_norm; uint8_t pct; };
static const CurvePoint kLipoCurve[] = {
    {0.000f,   0}, {0.100f,   5}, {0.200f,  10}, {0.300f,  18},
    {0.400f,  28}, {0.500f,  40}, {0.600f,  53}, {0.700f,  66},
    {0.800f,  78}, {0.900f,  90}, {1.000f, 100},
};

// Convert cell millivolt reading to percent SoC by clamping into the
// learned [empty..full] range and interpolating the table.
static uint8_t voltage_to_percent(uint16_t mv)
{
    if (mv <= v_empty_mv) return 0;
    if (mv >= v_full_mv) return 100;

    float norm = (float)(mv - v_empty_mv) / (float)(v_full_mv - v_empty_mv);
    for (size_t i = 1; i < sizeof(kLipoCurve) / sizeof(kLipoCurve[0]); i++)
    {
        if (norm <= kLipoCurve[i].v_norm)
        {
            const CurvePoint &lo = kLipoCurve[i - 1];
            const CurvePoint &hi = kLipoCurve[i];
            float t = (norm - lo.v_norm) / (hi.v_norm - lo.v_norm);
            return (uint8_t)(lo.pct + t * (hi.pct - lo.pct));
        }
    }
    return 100;
}

// Convert rail millivolt reading to percent during charging. Linear
// between learned bounds — during CC the rail rises roughly linearly
// with cell SoC, and during CV it saturates at v_chg_full so the
// display sits at 100% during topping-off (typical battery-indicator
// behavior; matches user expectation).
static uint8_t rail_to_charge_percent(uint16_t mv)
{
    if (mv <= v_chg_empty_mv) return 0;
    if (mv >= v_chg_full_mv) return 100;
    int span = (int)v_chg_full_mv - (int)v_chg_empty_mv;
    if (span <= 0) return 0;
    return (uint8_t)(((int)mv - (int)v_chg_empty_mv) * 100 / span);
}

static bool update_v_empty(uint16_t mv, bool charging)
{
    if (mv == 0 || charging) return false;
    if (mv < v_empty_mv && mv >= V_EMPTY_MIN_MV && mv <= V_EMPTY_MAX_MV)
    {
        v_empty_mv = mv;
        return true;
    }
    return false;
}

// Ratchet anchors. v_full / v_chg_full only ever move upward; v_chg_empty
// only ever moves downward. Out-of-band readings are rejected entirely
// so a stray ADC outlier (or USB-rail measurement leaking into the cell
// path) can't poison the learned value.
static bool try_set_v_full(uint16_t mv)
{
    if (mv >= V_FULL_MIN_MV && mv <= V_FULL_MAX_MV && mv > v_full_mv)
    {
        v_full_mv = mv;
        return true;
    }
    return false;
}

static bool try_set_v_chg_full(uint16_t mv)
{
    if (mv >= V_CHG_FULL_MIN_MV && mv <= V_CHG_FULL_MAX_MV && mv > v_chg_full_mv)
    {
        v_chg_full_mv = mv;
        return true;
    }
    return false;
}

static bool try_set_v_chg_empty(uint16_t mv)
{
    if (mv >= V_CHG_EMPTY_MIN_MV && mv <= V_CHG_EMPTY_MAX_MV && mv < v_chg_empty_mv)
    {
        v_chg_empty_mv = mv;
        return true;
    }
    return false;
}

uint32_t battery_get_mV(void)
{
#ifdef ENV_WAVESHARE
    // Average several ADC reads to smooth out single-sample noise. The
    // ESP32-S3 ADC has ~10 mV peak-peak noise per read in practice; 16
    // reads cuts that to ~3 mV without slowing the loop noticeably.
    constexpr int OVERSAMPLE = 16;
    int sum = 0;
    int got = 0;
    for (int i = 0; i < OVERSAMPLE; i++)
    {
        int raw = 0;
        if (adc_oneshot_read(adc1_handle, BAT_ADC_CHANNEL, &raw) != ESP_OK)
            continue;
        int mv = 0;
        if (adc_cali_raw_to_voltage(adc_cali_handle, raw, &mv) != ESP_OK)
            continue;
        sum += mv;
        got++;
    }
    if (got == 0)
    {
        ESP_LOGE(TAG, "ADC read failed");
        return 0;
    }
    int avg_mv = sum / got;
    return (uint32_t)(avg_mv * BAT_DIVIDER_RATIO);
#else
    return 0;
#endif
}

// Rolling history of voltage samples for slope estimation. Buffer length
// covers ~10 s at the 1.6 s task period — short enough to react to
// plug/unplug within a few seconds, long enough to average out load-sag
// noise that can otherwise trick a single-delta detector.
#define BATT_HISTORY_LEN 7
#define BATT_TICK_MS 1600

// Slope thresholds (mV/sec).
#define CHG_RISE_MV_PER_SEC 3.0f
#define CHG_FALL_MV_PER_SEC -1.0f

// Absolute voltage above which we know we're on USB. The cell's resting
// voltage tops out around 3.9 V on this board; anything sustainably
// ≥ 4.0 V is the post-diode USB Vbus showing through.
#define CHG_PLATEAU_MV 4000

// Sudden voltage jump (in either direction) — instant override.
#define CHG_EDGE_MV 150

// After an awake↔asleep transition the system rail rebounds (sleep) or
// sags (wake) by ~150–250 mV over a couple of seconds. During this
// window we hold the previous percent / charging state — the spike
// trivially clears CHG_EDGE_MV and would otherwise flip the charging
// flag on every wake.
#define TRANSITION_BLACKOUT_TICKS 5  // ~8 s

// Post-plug-in settling window. The first samples after USB connect are
// the Vbus-minus-diode no-load spike (~4.6 V), well above any real
// stable rail voltage. We hold the displayed percent and suppress
// downward charging-state flips for this long so the spike decay
// doesn't get misread as an unplug, and the v_chg_empty learning
// gets a stable rail reading instead of the spike. ~10 ticks ≈ 16 s.
#define PLUGIN_SETTLE_TICKS 10

// Discharge-voltage EMA shift. Even 5 mV of ADC noise can move the
// curve interpolation across a percent boundary — visibly flickery.
// α = 1/8 gives a ~12 s time constant: smooth enough that the display
// only ticks down once the underlying voltage really has, short enough
// that a real drop shows up within a minute.
#define DISCHARGE_EMA_SHIFT 3  // α = 1 / (1<<3) = 1/8

// Margin around v_chg_full within which an unplug edge counts as
// "from full." The smoothed pre-unplug reading rarely sits exactly at
// the lifetime peak — the rail bounces around the CV regulation point
// by 50–100 mV, and v_chg_full ratchets up to the highest sample ever.
// A wide window means any unplug from the broader CV-plateau region
// still triggers v_full learning.
#define V_CHG_FULL_AT_PEAK_MARGIN_MV 300

// Rolling mean window applied to per-tick voltage readings before they
// land in `watch.battery.voltage`. battery_get_mV already oversamples
// 16× per call, but residual ADC noise still bounces the displayed
// value across percent boundaries. A 5-sample mean (~8 s at the 1.6 s
// task period) smooths the display without lagging real changes more
// than the existing settle / blackout windows already do. Raw values
// are still used for the edge detector — smoothing the diff would
// dilute the plug/unplug step below CHG_EDGE_MV.
#define SMOOTH_WINDOW_LEN 5

void battery_task(void *)
{
    // Seed the rolling-mean buffer with the initial reading so the very
    // first smoothed value isn't biased toward zero. last_raw tracks the
    // unsmoothed previous-tick reading for the edge detector.
    uint32_t initial = battery_get_mV();
    uint16_t smooth_buf[SMOOTH_WINDOW_LEN];
    for (int i = 0; i < SMOOTH_WINDOW_LEN; i++) smooth_buf[i] = (uint16_t)initial;
    int smooth_count = SMOOTH_WINDOW_LEN;
    int smooth_idx = 0;
    uint32_t last_raw = initial;
    watch.battery.voltage = (uint16_t)initial;

    // Boot heuristic: if the very first voltage reading is high enough
    // to be the USB rail, flip the charging flag immediately so the
    // percent display doesn't briefly read "100% from rail" before the
    // slope/plateau detector catches up. Same trigger gates the
    // one-shot v_chg_empty learn — only attempt the learn if we just
    // came back from a brown-out AND we're now on USB.
    bool plugged_in_at_boot = (watch.battery.voltage >= CHG_PLATEAU_MV);
    if (plugged_in_at_boot) watch.battery.charging = true;
    bool pending_chg_empty_learn = boot_from_brownout && plugged_in_at_boot;

    uint16_t hist[BATT_HISTORY_LEN] = {0};
    int hist_count = 0;
    int hist_idx = 0;

    uint8_t last_sent_pct = 255;
    bool last_sent_chg = false;
    int64_t last_send_us = 0;
    int64_t last_persist_us = 0;
    bool dirty = false;

    bool last_sleeping = watch.sleeping;
    int settle_ticks_remaining = 0;
    uint16_t v_before_transition = 0;
    bool transitioned_to_asleep = false;

    int transition_blackout = 0;

    int plugin_settle_remaining = plugged_in_at_boot ? PLUGIN_SETTLE_TICKS : 0;

    // Set on the unplug edge when pre-unplug rail was at the v_chg_full
    // peak. After post_unplug_settle ticks the cell will have relaxed
    // off the charging current and the next compensated reading is a
    // valid v_full candidate.
    bool expect_v_full_capture = false;
    int post_unplug_settle = 0;

    // EMA-filtered v_compensated for the discharging percent path.
    int32_t v_filtered_mv = 0;

    while (true)
    {
        bool was_charging = watch.battery.charging;
        uint16_t last_voltage = watch.battery.voltage;

        uint32_t raw = battery_get_mV();
        smooth_buf[smooth_idx] = (uint16_t)raw;
        smooth_idx = (smooth_idx + 1) % SMOOTH_WINDOW_LEN;
        if (smooth_count < SMOOTH_WINDOW_LEN) smooth_count++;
        uint32_t sum = 0;
        for (int i = 0; i < smooth_count; i++) sum += smooth_buf[i];
        watch.battery.voltage = (uint16_t)(sum / smooth_count);

        if (watch.sleeping != last_sleeping)
        {
            v_before_transition = last_voltage;
            transitioned_to_asleep = watch.sleeping;
            settle_ticks_remaining = TRANSITION_BLACKOUT_TICKS;
            transition_blackout = TRANSITION_BLACKOUT_TICKS;
            last_sleeping = watch.sleeping;
            // The rail spike from the transition would otherwise live in
            // the slope buffer for BATT_HISTORY_LEN ticks past blackout
            // end and skew the regression. Throw away the pre-transition
            // samples.
            hist_count = 0;
            hist_idx = 0;
        }
        else if (settle_ticks_remaining > 0 && --settle_ticks_remaining == 0
                 && v_before_transition != 0)
        {
            int delta = (int)watch.battery.voltage - (int)v_before_transition;
            int sample = transitioned_to_asleep ? delta : -delta;
            if (sample > -LOAD_OFFSET_MAX_MV && sample < LOAD_OFFSET_MAX_MV)
            {
                int prev = load_offset_mv;
                load_offset_mv = (load_offset_mv * 7 + sample) / 8;
                if (load_offset_mv != prev) dirty = true;
            }
            v_before_transition = 0;
        }

        if (transition_blackout > 0) transition_blackout--;
        if (plugin_settle_remaining > 0)
        {
            plugin_settle_remaining--;
            // When settle ends, reset the slope buffer too — otherwise
            // the descending spike samples are still in it and a slope
            // check would immediately flip charging off.
            if (plugin_settle_remaining == 0)
            {
                hist_count = 0;
                hist_idx = 0;
            }
        }

        // Compensate live readings to "asleep equivalent" so the discharge
        // curve and percent display don't bounce with load changes.
        uint16_t v_compensated = watch.battery.voltage;
        if (!watch.sleeping)
        {
            int adj = (int)v_compensated + load_offset_mv;
            if (adj < 0) adj = 0;
            if (adj > 0xFFFF) adj = 0xFFFF;
            v_compensated = (uint16_t)adj;
        }

        hist[hist_idx] = watch.battery.voltage;
        hist_idx = (hist_idx + 1) % BATT_HISTORY_LEN;
        if (hist_count < BATT_HISTORY_LEN) hist_count++;

        // Charging-state detection. Suppressed during transition blackout
        // (wake/sleep spike). During plug-in settle, only upward edges
        // are honored — the spike decay produces a strong downward edge
        // that must NOT be misread as an unplug while charging is real.
        if (transition_blackout == 0)
        {
            // Edge detection uses the raw reading — smoothing the diff
            // would dilute the plug/unplug step (~500–800 mV raw becomes
            // ~100–160 mV after a 5-sample mean) below CHG_EDGE_MV.
            int32_t diff = (int32_t)raw - (int32_t)last_raw;
            if (diff > CHG_EDGE_MV)
                watch.battery.charging = true;
            else if (diff < -CHG_EDGE_MV && plugin_settle_remaining == 0)
                watch.battery.charging = false;

            if (hist_count == BATT_HISTORY_LEN && plugin_settle_remaining == 0)
            {
                float n = BATT_HISTORY_LEN;
                float sum_x = 0, sum_y = 0, sum_xy = 0, sum_xx = 0;
                for (int i = 0; i < BATT_HISTORY_LEN; i++)
                {
                    int read_idx = (hist_idx + i) % BATT_HISTORY_LEN;
                    float x = (float)i;
                    float y = (float)hist[read_idx];
                    sum_x += x;
                    sum_y += y;
                    sum_xy += x * y;
                    sum_xx += x * x;
                }
                float slope_per_sample = (n * sum_xy - sum_x * sum_y) /
                                         (n * sum_xx - sum_x * sum_x);
                float slope_mV_s = slope_per_sample / (BATT_TICK_MS / 1000.0f);

                if (watch.battery.voltage >= CHG_PLATEAU_MV)
                    watch.battery.charging = true;
                else if (slope_mV_s > CHG_RISE_MV_PER_SEC)
                    watch.battery.charging = true;
                else if (slope_mV_s < CHG_FALL_MV_PER_SEC)
                    watch.battery.charging = false;
            }
        }

        // Charging-state edge handling.
        //   plug-in: arm the settling window and reset the discharge EMA.
        //            The pending_chg_empty_learn flag is already set (or
        //            not) from boot — a later in-flight plug-in event
        //            doesn't trigger v_chg_empty learning.
        //   unplug:  if pre-unplug rail was at v_chg_full (within margin),
        //            arm the post-unplug settle so we capture v_full from
        //            the relaxed cell voltage a few seconds later.
        //   either:  reset hist + EMA so the next-state detector starts
        //            from a clean slate.
        if (was_charging != watch.battery.charging)
        {
            v_filtered_mv = 0;
            hist_count = 0;
            hist_idx = 0;
            if (watch.battery.charging)
            {
                plugin_settle_remaining = PLUGIN_SETTLE_TICKS;
                if (watch.battery.percent > 100) watch.battery.percent = 0;
            }
            else
            {
                if ((int)last_voltage
                    >= (int)v_chg_full_mv - V_CHG_FULL_AT_PEAK_MARGIN_MV)
                {
                    expect_v_full_capture = true;
                    post_unplug_settle = TRANSITION_BLACKOUT_TICKS;
                }
                else
                {
                    expect_v_full_capture = false;
                    post_unplug_settle = 0;
                }
            }
        }

        // Anchor learning.
        //   v_empty:     ratchet down on any compensated discharging
        //                reading in band. Captures the "lowest voltage
        //                before shutdown" naturally — the final reading
        //                pre-brownout is the lowest seen.
        //   v_chg_full:  ratchet up on any post-settle charging reading.
        //                That's the lifetime peak rail voltage, which
        //                matches the user's "highest voltage ever
        //                detected = max charging voltage" definition.
        //   v_full:      one-off capture after an unplug-from-peak,
        //                using the compensated post-settle reading.
        //   v_chg_empty: one-shot capture at boot-from-brownout + USB,
        //                after settle. Only one chance per session.
        bool v_empty_changed = update_v_empty(v_compensated, watch.battery.charging);
        bool anchors_changed = v_empty_changed;
        if (v_empty_changed)
        {
            ESP_LOGI(TAG, "learned v_empty=%u", v_empty_mv);
            send_info("v_empty=%u", v_empty_mv);
        }

        if (watch.battery.charging && plugin_settle_remaining == 0)
        {
            if (try_set_v_chg_full(watch.battery.voltage))
            {
                anchors_changed = true;
                ESP_LOGI(TAG, "learned v_chg_full=%u", v_chg_full_mv);
                send_info("v_chg_full=%u", v_chg_full_mv);
            }
            if (pending_chg_empty_learn)
            {
                if (try_set_v_chg_empty(watch.battery.voltage))
                {
                    anchors_changed = true;
                    ESP_LOGI(TAG, "learned v_chg_empty=%u (brownout boot)",
                             v_chg_empty_mv);
                    send_info("v_chg_empty=%u (brownout boot)", v_chg_empty_mv);
                }
                pending_chg_empty_learn = false;
            }
        }

        if (expect_v_full_capture && post_unplug_settle > 0
            && --post_unplug_settle == 0)
        {
            if (try_set_v_full(v_compensated))
            {
                anchors_changed = true;
                ESP_LOGI(TAG, "learned v_full=%u (unplug from peak)", v_full_mv);
                send_info("v_full=%u (unplug from peak)", v_full_mv);
            }
            expect_v_full_capture = false;
        }

        // Percent computation.
        //   - charging + settling: hold previous pct; the rail is still
        //                          dropping from the Vbus-minus-diode
        //                          spike and any reading taken now
        //                          would peg at 100%.
        //   - charging:            rail_to_charge_percent. As the cell
        //                          actually charges, the rail rises
        //                          through the learned span, so the
        //                          display tracks charge progress.
        //   - blackout:            keep previous pct (rail rebound/sag).
        //   - otherwise:           voltage_to_percent on the EMA-filtered
        //                          compensated reading so the display
        //                          doesn't tick across single-sample
        //                          ADC noise.
        int64_t now = esp_timer_get_time();
        if (watch.battery.charging)
        {
            if (plugin_settle_remaining == 0)
                watch.battery.percent = rail_to_charge_percent(watch.battery.voltage);
            // else: hold previous percent through the settling window.
        }
        else
        {
            if (transition_blackout == 0)
            {
                if (v_filtered_mv == 0)
                    v_filtered_mv = (int32_t)v_compensated;
                else
                    v_filtered_mv = ((v_filtered_mv * ((1 << DISCHARGE_EMA_SHIFT) - 1))
                                     + (int32_t)v_compensated) >> DISCHARGE_EMA_SHIFT;
                watch.battery.percent = voltage_to_percent((uint16_t)v_filtered_mv);
            }
        }

        // Persist learned state. Anchors and load_offset change rarely;
        // rate-limit to one NVS write per 5 minutes so wear stays low.
        if (anchors_changed) dirty = true;
        if (dirty && (now - last_persist_us) > 5LL * 60 * 1000 * 1000)
        {
            watch.settings.writeUint16("bat_full", v_full_mv);
            watch.settings.writeUint16("bat_empty", v_empty_mv);
            watch.settings.writeUint16("bat_chgfull", v_chg_full_mv);
            watch.settings.writeUint16("bat_chgempty", v_chg_empty_mv);
            watch.settings.writeUint16("bat_load",
                (uint16_t)(load_offset_mv + LOAD_OFFSET_NVS_BIAS));
            last_persist_us = now;
            dirty = false;
        }

        // Push status to Gadgetbridge when the percent changes by ≥1,
        // the charging flag flips, or every 60 s as a heartbeat. send_gb
        // is a no-op when no peer is subscribed, so this is cheap if
        // nobody's listening.
        bool pct_changed = watch.battery.percent != last_sent_pct;
        bool chg_changed = watch.battery.charging != last_sent_chg;
        bool heartbeat = (now - last_send_us) > 60LL * 1000 * 1000;
        if (ble.connected() && (pct_changed || chg_changed || heartbeat))
        {
            ble.send_status();
            last_sent_pct = watch.battery.percent;
            last_sent_chg = watch.battery.charging;
            last_send_us = now;
        }

        last_raw = raw;
        vTaskDelay(pdMS_TO_TICKS(BATT_TICK_MS));
    }
}

void battery_init(void)
{
#ifdef ENV_WAVESHARE
    adc_oneshot_unit_init_cfg_t init_cfg = {
        .unit_id = ADC_UNIT_1,
    };
    ESP_ERROR_CHECK(adc_oneshot_new_unit(&init_cfg, &adc1_handle));

    adc_oneshot_chan_cfg_t chan_cfg = {
        .atten = ADC_ATTEN_DB_12,         // up to ~3.3V input (was DB_11, renamed in v5.x)
        .bitwidth = ADC_BITWIDTH_DEFAULT, // 12-bit
    };
    ESP_ERROR_CHECK(adc_oneshot_config_channel(adc1_handle, BAT_ADC_CHANNEL, &chan_cfg));

    adc_cali_curve_fitting_config_t cali_cfg = {
        .unit_id = ADC_UNIT_1,
        .chan = BAT_ADC_CHANNEL,
        .atten = ADC_ATTEN_DB_12,
        .bitwidth = ADC_BITWIDTH_DEFAULT,
    };
    ESP_ERROR_CHECK(adc_cali_create_scheme_curve_fitting(&cali_cfg, &adc_cali_handle));

    // Brown-out reset (cell discharged to brownout threshold) tells us
    // the cell really was empty when we lost power. Combined with a
    // boot-time "are we on USB?" check, this is the only moment we can
    // confidently identify "cell at v_empty AND charging" to capture
    // v_chg_empty.
    boot_from_brownout = (esp_reset_reason() == ESP_RST_BROWNOUT);

    v_full_mv = watch.settings.readUint16("bat_full", V_FULL_DEFAULT_MV);
    v_empty_mv = watch.settings.readUint16("bat_empty", V_EMPTY_DEFAULT_MV);
    v_chg_full_mv = watch.settings.readUint16("bat_chgfull", V_CHG_FULL_DEFAULT_MV);
    v_chg_empty_mv = watch.settings.readUint16("bat_chgempty", V_CHG_EMPTY_DEFAULT_MV);

    if (v_full_mv < V_FULL_MIN_MV || v_full_mv > V_FULL_MAX_MV)
        v_full_mv = V_FULL_DEFAULT_MV;
    if (v_empty_mv < V_EMPTY_MIN_MV || v_empty_mv > V_EMPTY_MAX_MV)
        v_empty_mv = V_EMPTY_DEFAULT_MV;
    if (v_chg_full_mv < V_CHG_FULL_MIN_MV || v_chg_full_mv > V_CHG_FULL_MAX_MV)
        v_chg_full_mv = V_CHG_FULL_DEFAULT_MV;
    if (v_chg_empty_mv < V_CHG_EMPTY_MIN_MV || v_chg_empty_mv > V_CHG_EMPTY_MAX_MV)
        v_chg_empty_mv = V_CHG_EMPTY_DEFAULT_MV;

    uint16_t stored_load = watch.settings.readUint16(
        "bat_load", (uint16_t)(LOAD_OFFSET_DEFAULT_MV + LOAD_OFFSET_NVS_BIAS));
    int loaded = (int)stored_load - LOAD_OFFSET_NVS_BIAS;
    if (loaded < -LOAD_OFFSET_MAX_MV || loaded > LOAD_OFFSET_MAX_MV)
        loaded = LOAD_OFFSET_DEFAULT_MV;
    load_offset_mv = loaded;

    watch.battery.voltage = UINT16_MAX;
    watch.battery.percent = UINT8_MAX;

    // Stack MUST stay in internal SRAM — battery_task writes its learned
    // anchors to NVS, which the SPI flash driver implements by disabling
    // the cache around the write. A PSRAM-backed stack disappears from
    // the CPU's view the moment cache is disabled, and esp_task_stack_is_
    // sane_cache_disabled() asserts on entry to the flash op.
    xTaskCreate(battery_task, "battery_task", 1024 * 3, NULL, 2, NULL);
#else
#error "Please add battery code for this new hardware"
#endif
}
